# Copy to .env.local and fill in (never commit .env.local)
# Local Supabase API URL: use 54321, not the Studio port (54323).
# If you are not running the local stack, use your hosted Supabase URL instead.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Paste these from `npx supabase status` (or your hosted project settings).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub (fine-grained PAT, Contents + Metadata read, selected repos only)
GITHUB_PAT=

# Upstash Redis (hot cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Route protection
REVALIDATE_SECRET=
CRON_SECRET=
